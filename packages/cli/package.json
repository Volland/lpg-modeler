{
  "name": "lpg-modeler-cli",
  "version": "0.15.0",
  "type": "commonjs",
  "bin": {
    "lpg": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/bundle.mjs",
    "prepublishOnly": "npm run build"
  },
  "description": "Design a property graph once. Generate every schema from it: LadybugDB, Neo4j, FalkorDB, Memgraph, GQL, PG-Schema, SHACL, OWL and LinkML.",
  "license": "MIT",
  "homepage": "https://volland.github.io/lpg-modeler/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Volland/lpg-modeler.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Volland/lpg-modeler/issues"
  },
  "keywords": [
    "graph",
    "property graph",
    "labeled property graph",
    "lpg",
    "schema",
    "neo4j",
    "memgraph",
    "cypher",
    "falkordb",
    "ladybugdb",
    "kuzu",
    "gql",
    "pg-schema",
    "linkml",
    "shacl",
    "owl",
    "rdf",
    "ontology",
    "data modeling",
    "ddl"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@ladybugdb/core": "0.19.1",
    "neo4j-driver": "^6.2.0",
    "redis": "^6.2.1"
  },
  "peerDependenciesMeta": {
    "@ladybugdb/core": {
      "optional": true
    },
    "neo4j-driver": {
      "optional": true
    },
    "redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lpg/core": "*",
    "esbuild": "^0.24.0"
  }
}
