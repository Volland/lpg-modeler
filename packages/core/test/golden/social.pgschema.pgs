//
// PG-Schema (LDBC Property Graph Schema Working Group). STRICT means every node and
// edge must conform to a declared type: the same closed-world reading this metamodel
// already has. Abstract types and mixins survive as ABSTRACT types, so nothing is
// flattened. See lat.md/emitters#PG-Schema Target.

CREATE GRAPH TYPE socialType STRICT {
  ABSTRACT (timestampedType {createdAt ZONED DATETIME}),
  (carType: Car {vin STRING, OPTIONAL seats INTEGER}),
  ABSTRACT (partyType: Party {id STRING}),
  (companyType: partyType & Company {OPTIONAL vat STRING}),
  (personType: partyType & timestampedType & Person {email STRING, OPTIONAL born DATE}),
  (:personType)-[knowsType: KNOWS {OPTIONAL since DATE}]->(:personType),
  (:personType)-[likesType: LIKES]->(:companyType),
  (:partyType)-[ownsType: OWNS {OPTIONAL since DATE}]->(:carType),
  FOR (x: carType) EXCLUSIVE MANDATORY SINGLETON x.vin,
  FOR (x: partyType) EXCLUSIVE MANDATORY SINGLETON x.id,
  FOR (x: personType) EXCLUSIVE SINGLETON x.email
}
