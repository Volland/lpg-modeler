# Generated by lpg-modeler. Target: owl.
#
# Deliberately restricted to the safe assertional subset: classes, subClassOf and
# hasKey. No rdfs:domain, no rdfs:range, and no cardinality restrictions are
# emitted -- those state inference rules, not constraints, and a reasoner would
# use them to classify individuals rather than to reject bad data. Constraints
# are carried by the SHACL artifact. See lat.md/emitters#OWL Subset.

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix social: <https://example.org/vocab/social#> .

social:Car a owl:Class ;
  rdfs:label "Car" ;
  owl:hasKey ( social:vin ) .

social:Company a owl:Class ;
  rdfs:label "Company" ;
  rdfs:subClassOf social:Party ;
  owl:hasKey ( social:id ) .

# uninstantiable class, so it is emitted as an ordinary class.
# 'Party' is abstract in the model. OWL has no notion of an
social:Party a owl:Class ;
  rdfs:label "Party" ;
  owl:hasKey ( social:id ) .

social:Person a owl:Class ;
  rdfs:label "Person" ;
  rdfs:subClassOf social:Party ;
  owl:hasKey ( social:id ) .

social:vin a owl:DatatypeProperty ; rdfs:label "vin" ; rdfs:range xsd:string .
social:seats a owl:DatatypeProperty ; rdfs:label "seats" ; rdfs:range xsd:integer .
social:vat a owl:DatatypeProperty ; rdfs:label "vat" ; rdfs:range xsd:string .
social:id a owl:DatatypeProperty ; rdfs:label "id" ; rdfs:range xsd:string .
social:email a owl:DatatypeProperty ; rdfs:label "email" ; rdfs:range xsd:string .
social:born a owl:DatatypeProperty ; rdfs:label "born" ; rdfs:range xsd:date .
social:createdAt a owl:DatatypeProperty ; rdfs:label "createdAt" ; rdfs:range xsd:dateTime .

# (:Person)-[:KNOWS]->(:Person) carries properties, so it is
# reified into a class. 'knows' is the shortcut for querying.
social:Knows a owl:Class ; rdfs:label "KNOWS" .
social:knowsSubject a owl:ObjectProperty .
social:knowsObject a owl:ObjectProperty .
social:knows a owl:ObjectProperty .
social:since a owl:DatatypeProperty ; rdfs:range xsd:date .

# (:Person)-[:LIKES]->(:Company) carries no properties,
# so it stays a plain object property. No domain or range is asserted.
social:likes a owl:ObjectProperty ; rdfs:label "LIKES" .

# (:Party)-[:OWNS]->(:Car) carries properties, so it is
# reified into a class. 'owns' is the shortcut for querying.
social:Owns a owl:Class ; rdfs:label "OWNS" .
social:ownsSubject a owl:ObjectProperty .
social:ownsObject a owl:ObjectProperty .
social:owns a owl:ObjectProperty .
social:since a owl:DatatypeProperty ; rdfs:range xsd:date .
