# Sources and build inputs: out/ is bundled and self-contained.
src/**
test/**
scripts/**
tsconfig.json
node_modules/**

# tsc leaves unbundled emit beside the bundle; only the bundles ship.
out/**/*.map
out/**/*.d.ts
out/protocol.*
out/intents.*
out/webview/**

# Repository noise. Agent tooling drops state directories here; they are gitignored,
# which is why vsce -- which reads only its own ignore file -- would otherwise ship them.
.eslintrc.json
**/.DS_Store
.omc/**
.gstack/**
*.vsix
