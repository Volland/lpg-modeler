{
  "name": "lpg-modeler",
  "displayName": "LPG Modeler",
  "description": "Visual modeling for labeled property graphs, with Ladybug, Neo4j, SHACL and OWL generation.",
  "version": "0.11.0",
  "publisher": "pavlyshyn",
  "license": "MIT",
  "icon": "icon.png",
  "homepage": "https://volland.github.io/lpg-modeler/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Volland/lpg-modeler.git",
    "directory": "packages/vscode"
  },
  "bugs": {
    "url": "https://github.com/Volland/lpg-modeler/issues"
  },
  "qna": "https://github.com/Volland/lpg-modeler/issues",
  "galleryBanner": {
    "color": "#2f5fe0",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "graph",
    "property graph",
    "labeled property graph",
    "lpg",
    "schema",
    "neo4j",
    "cypher",
    "ladybugdb",
    "kuzu",
    "rdf",
    "shacl",
    "owl",
    "ontology",
    "gql",
    "iso 39075",
    "pg-schema",
    "linkml",
    "erd",
    "data modeling",
    "knowledge graph"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:yaml",
    "onCommand:lpg.newModel"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-webview.mjs",
    "package": "npm run build && vsce package --no-dependencies",
    "publish": "npm run build && vsce publish --no-dependencies"
  },
  "contributes": {
    "commands": [
      {
        "command": "lpg.newModel",
        "title": "LPG: New Model"
      },
      {
        "command": "lpg.import",
        "title": "LPG: Import Model…"
      },
      {
        "command": "lpg.openCanvas",
        "title": "LPG: Open Canvas"
      },
      {
        "command": "lpg.generate",
        "title": "LPG: Generate Schema"
      },
      {
        "command": "lpg.exportPng",
        "title": "LPG: Export Diagram as PNG",
        "icon": "$(file-media)"
      },
      {
        "command": "lpg.exportSvg",
        "title": "LPG: Export Diagram as SVG",
        "icon": "$(symbol-color)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "lpg.exportPng",
          "group": "navigation@1",
          "when": "resourceFilename =~ /\\.lpg\\.ya?ml$/ || activeWebviewPanelId == lpg.canvas"
        },
        {
          "command": "lpg.exportSvg",
          "group": "navigation@2",
          "when": "resourceFilename =~ /\\.lpg\\.ya?ml$/ || activeWebviewPanelId == lpg.canvas"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "*.lpg.yaml",
          "*.lpg.yml"
        ],
        "url": "./schemas/lpg.schema.json"
      }
    ],
    "configuration": {
      "title": "LPG Modeler",
      "properties": {
        "lpg.targets.neo4j.edition": {
          "type": "string",
          "enum": [
            "community",
            "enterprise"
          ],
          "default": "community",
          "description": "Neo4j edition. Community cannot enforce existence or node key constraints."
        },
        "lpg.targets.falkordb.graphKey": {
          "type": "string",
          "default": "",
          "description": "FalkorDB: the Redis key the graph lives under. Empty means the model's own namespace prefix names it."
        }
      }
    }
  },
  "dependencies": {
    "@lpg/core": "*",
    "@xyflow/react": "^12.11.5",
    "elkjs": "^0.9.3",
    "html-to-image": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.2"
  }
}
