{
  "name": "lpg-modeler",
  "displayName": "LPG Modeler",
  "description": "Visual modeling for labeled property graphs, with Ladybug, Neo4j, SHACL and OWL generation.",
  "version": "0.1.0",
  "publisher": "lpg",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:yaml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-webview.mjs"
  },
  "contributes": {
    "commands": [
      {
        "command": "lpg.openCanvas",
        "title": "LPG: Open Canvas"
      },
      {
        "command": "lpg.generate",
        "title": "LPG: Generate Schema"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "*.lpg.yaml",
          "*.lpg.yml"
        ],
        "url": "./schemas/lpg.schema.json"
      }
    ],
    "configuration": {
      "title": "LPG Modeler",
      "properties": {
        "lpg.targets.neo4j.edition": {
          "type": "string",
          "enum": [
            "community",
            "enterprise"
          ],
          "default": "community",
          "description": "Neo4j edition. Community cannot enforce existence or node key constraints."
        }
      }
    }
  },
  "dependencies": {
    "@lpg/core": "*",
    "@xyflow/react": "^12.11.5",
    "elkjs": "^0.9.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/vscode": "^1.134.0",
    "esbuild": "^0.24.2"
  }
}
